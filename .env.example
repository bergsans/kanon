# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# The model for query expansion and reranking. Sonnet is the default and measured
# as equivalent to Opus on both steps — see the comment in src/lib/claude.ts.
# CANON_MODEL=claude-opus-5

# --- Local reranking (cross-encoder between retrieval and Claude) -----------
# The model choice is measured; see src/lib/rerank.ts before switching it.
# CANON_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# CANON_RERANK_DTYPE=fp32
# How many candidates it reads. More gives a better selection and a longer
# wait, roughly 70 ms per passage, though batching absorbs most of a doubling
# (~0.3s for 96→192, see RERANK_POOL in src/lib/search.ts). Raised 48→96→192:
# first because Hegel's best passage on "progress happens in history" sat at
# fusion rank 73 and was never read, then again alongside CANDIDATES 28→64 so
# the pool stays several times the candidate list. Lower for a shorter wait
# and worse depth.
# CANON_RERANK_POOL=192
# Set to 0 to disable the step entirely — then the fusion order goes straight to Claude.
# CANON_LOCAL_RERANK=1

# --- Local model (experimental, selected in the interface's corner) ----------
# Ollama's HTTP address. The default is localhost, so there's rarely a reason
# to set this — but an Ollama running on another machine or port
# needs it. See src/lib/local.ts and the README for the measurement against Sonnet.
# CANON_OLLAMA_URL=http://localhost:11434/api/chat

# Same thing for models in OPENAI_MODELS (provider.ts) — servers that speak
# OpenAI's /v1/chat/completions instead of Ollama's /api/chat, e.g.
# mlx-serve. The default is localhost:8080; mlx-serve usually runs on another
# machine on the network, so the address almost always needs to be set.
# CANON_MLX_URL=http://localhost:8080/v1/chat/completions

# Bearer token for the same server. mlx-serve doesn't read the value but requires
# the field to be present — "dummy" works against such a server. Set a real value
# only if the server actually checks the token.
# CANON_MLX_API_KEY=dummy

# --- External sources (the "utanför samlingen" checkbox) --------------------
# How many web searches the external step may run per query. NOT MEASURED —
# assumed; see EXTERNAL_MAX_USES in src/lib/claude.ts. Billed per search
# ($10 / 1 000), on top of the ordinary per-token price.
# CANON_EXTERNAL_MAX_USES=3

# --- Cache -------------------------------------------------------------------
# How similar two questions must be to share an answer. 0.95 is measured, see
# src/lib/searches.ts. Set to 0 to keep only the exact-match cache.
# CANON_CACHE_SIMILARITY=0.95

# --- Money ---------------------------------------------------------------
# The dollar-to-krona rate shown next to the dollar figure. A constant, not
# fetched daily — see FALLBACK_USD_SEK's own comment in src/lib/money.ts.
# Set this once the fallback (9,6) has drifted too far from reality.
# CANON_USD_SEK=9.6
